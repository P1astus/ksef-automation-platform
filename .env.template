# KSeF Automation Platform - Environment Variables
# Copy this file to .env and fill in the values

# n8n encryption key (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# PostgreSQL password for n8n internal database
POSTGRES_PASSWORD=

# PostgreSQL password for KSeF application database
KSEF_DB_PASSWORD=

# KSeF environment: test | demo | production
KSEF_ENVIRONMENT=test

# n8n REST API key (used by the n8n MCP server / automation tooling)
N8N_API_KEY=

# Secret used to sign portal session JWTs (generate with: openssl rand -hex 32)
# Required - the portal refuses to start without it (D9 fix: no insecure fallback).
JWT_SECRET=

# KSeF API base URL the n8n workflows call - defaults to the test endpoint if
# unset, so switching environments never accidentally means switching to prod.
# NEVER set this to https://api.ksef.mf.gov.pl without explicit production
# sign-off (D7 fix: replaces 27 hardcoded URLs across 4 workflow files).
KSEF_API_BASE=https://api-test.ksef.mf.gov.pl

# Shared secret required on every request to the XAdES sidecar except
# /actuator/**  (generate with: openssl rand -hex 32).
# Required - the sidecar refuses to start without it (round 4 fix: its 4
# crypto endpoints had no authentication at all and are published on 0.0.0.0).
SIDECAR_API_KEY=

# Shared secret required on requests to the portal's /api/notify/* routes
# (workflows/09-client-notifications.json calls these on a schedule). Same
# lenient-if-unset convention as DIGEST_SECRET - set it (openssl rand -hex 32)
# before this leaves a dev/test environment.
NOTIFY_SECRET=

# ---------------------------------------------------------------------------
# Portal optional settings (round 15). The portal image contains no .env file,
# so these reach it ONLY via docker-compose.yml's `portal` environment block
# (already wired). Leave blank = feature not configured: the routes that need
# one answer 503 / "e-mail NOT sent" instead of pretending.
# ---------------------------------------------------------------------------
# Public origin used in every emailed/redirect link (invites, password reset,
# document requests, Stripe success/cancel). No trailing slash. REQUIRED for
# any of those links to work.
NEXT_PUBLIC_APP_URL=
# Transactional e-mail (Resend). Without it: no password-reset mail, no invite
# mail, no client notifications/digests.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ALLOW_DEV_RESET_URL=false
# Shared secret for /api/digest (openssl rand -hex 32); the route 503s if unset.
DIGEST_SECRET=
# Stripe billing (needed before any real subscription).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_BIZNES=
STRIPE_PRICE_PRO=
# AI cost-category classification during client sync (Biznes/Pro only).
ANTHROPIC_API_KEY=

# 32-byte key used for AES-256-GCM encryption of KSeF and per-firm mailbox
# credentials. Generate once with: openssl rand -base64 32
# Back it up securely; losing it makes stored credentials unrecoverable.
KSEF_CREDENTIALS_KEY=
# Optional: n8n webhook the client-sync route calls.
N8N_SYNC_WEBHOOK_URL=
# Optional: ONE shared IMAP mailbox for /api/email/sync (see HANDOVER.md
# round 15 - it is process-wide, not per firm).

# XAdES-BES signing key for the MF JPK gateway metadata (optional). PKCS#12 path as seen inside the sidecar
# container (./certificates is mounted at /app/certificates). Leave empty to disable /sign-xades-bes.
JPK_SIGNING_KEYSTORE_PATH=
JPK_SIGNING_KEYSTORE_PASSWORD=
