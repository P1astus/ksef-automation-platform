        },
        "status": {
          "default": "'imported'",
          "notNull": true,
          "type": "character varying(24)"
        }
      },
      "constraints": {
        "zus_declarations_document_types_check": "check cardinalitydocument_types > 0",
        "zus_declarations_firm_id_client_nip_period_sha256_key": "unique firm_id, client_nip, period, sha256",
        "zus_declarations_firm_id_fkey": "foreign key firm_id references firmsid on delete cascade",
        "zus_declarations_period_check": "check period ~ '^0-9{4}-01-9|10-2$'",
        "zus_declarations_pkey": "primary key id",
        "zus_declarations_status_check": "check status = any array'imported', 'ready_for_export', 'exported'"
      }
    }
  }
}
