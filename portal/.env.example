# Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random secret string used to sign session JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=

# Stripe secret API key
STRIPE_SECRET_KEY=sk_test_placeholder_placeholder

# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_placeholder_placeholder

# Stripe Price ID for the 'start' tier
STRIPE_PRICE_START=price_placeholder_start

# Stripe Price ID for the 'biznes' tier
STRIPE_PRICE_BIZNES=price_placeholder_biznes

# Stripe Price ID for the 'pro' tier
STRIPE_PRICE_PRO=price_placeholder_pro

# The public URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mail transport: hosted defaults to resend; local defaults to smtp.
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=KSeF Auto <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=KSeF Auto <portal@example.com>
SMTP_CHECK_TO=operator@example.com

# Either 'test' or 'prod'
KSEF_ENVIRONMENT=test

# URL of the internal XAdES signing sidecar. Must be the hyphenated service
# name (xades-sidecar), never the underscored container_name (xades_sidecar)
# - Tomcat's embedded HTTP parser 400s on any Host header with an underscore.
XADES_SIDECAR_URL=http://xades-sidecar:8090

# Shared secret required on every request to the sidecar except
# /actuator/** - must match the sidecar's own SIDECAR_API_KEY (generate with:
# openssl rand -hex 32). The sidecar refuses to start without one set.
SIDECAR_API_KEY=

# Default-off, TEST-only JPK gateway action. The PEM is MF's public TEST
# encryption certificate, never a taxpayer certificate or private key.
JPK_TEST_GATEWAY_ENABLED=false
JPK_TEST_GATEWAY_CERTIFICATE_PEM=
JPK_TEST_GATEWAY_CERTIFICATE_BASE64=

# Shared secret required on requests to /api/notify/* (offline24 deadline
# warnings and the weekly receivables digest, called by
# workflows/09-client-notifications.json).
NOTIFY_SECRET=
