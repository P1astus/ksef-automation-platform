# Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random secret string used to sign session JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=

# Stripe secret API key
STRIPE_SECRET_KEY=sk_test_placeholder_placeholder

# Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_placeholder_placeholder

# Stripe Price ID for the 'start' tier
STRIPE_PRICE_START=price_placeholder_start

# Stripe Price ID for the 'biznes' tier
STRIPE_PRICE_BIZNES=price_placeholder_biznes

# Stripe Price ID for the 'pro' tier
STRIPE_PRICE_PRO=price_placeholder_pro

# The public URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Either 'test' or 'prod'
KSEF_ENVIRONMENT=test

# URL of the internal XAdES signing sidecar
XADES_SIDECAR_URL=http://xades_sidecar:8090
