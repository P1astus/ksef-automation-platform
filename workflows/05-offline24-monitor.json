                      "operator": {
                        "type": "string",
                        "operation": "equals"
                      },
                      "leftValue": "={{ $json.urgency }}",
                      "rightValue": "urgent_4h"
                    }
                  ]
                },
                "renameOutput": true,
                "outputKey": "Urgent 4h"
              }
            ]
          },
          "options": {
            "fallbackOutput": "extra",
            "renameFallbackOutput": "OK - No Action"
          }
        }
      },
