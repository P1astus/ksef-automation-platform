      {
        "id": "a1b2c3d4-0001-4000-a000-000000000005",
        "name": "Process Each Invoice",
        "type": "n8n-nodes-base.splitInBatches",
        "typeVersion": 3,
        "position": [
          1000,
          360
        ],
        "parameters": {
          "batchSize": 1,
          "options": {}
