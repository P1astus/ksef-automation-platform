    {
      "id": "a1b2c3d4-0001-4000-a000-000000000006",
      "name": "Calculate Time Remaining",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        360
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const now = new Date();\nconst deadline = new Date($json.upload_deadline);\nconst diffMs = deadline.getTime() - now.getTime();\nconst diffHours = diffMs / (1000 * 60 * 60);\nconst diffMinutes = Math.round(diffMs / (1000 * 60));\n\nlet urgency;\nlet urgencyLabel;\n\nif (diffMs <= 0) {\n  urgency = 'overdue';\n  urgencyLabel = `OVERDUE by ${Math.abs(diffMinutes)} minutes`;\n} else if (diffHours < 1) {\n  urgency = 'urgent_1h';\n  urgencyLabel = `${diffMinutes} minutes remaining`;\n} else if (diffHours < 4) {\n  urgency = 'urgent_4h';\n  urgencyLabel = `${Math.round(diffHours * 10) / 10} hours remaining`;\n} else {\n  urgency = 'ok';\n  urgencyLabel = `${Math.round(diffHours * 10) / 10} hours remaining - safe`;\n}\n\nreturn {\n  json: {\n    ...$json,\n    urgency,\n    urgencyLabel,\n    hoursRemaining: Math.round(diffHours * 100) / 100,\n    minutesRemaining: diffMinutes,\n    checkedAt: now.toISOString()\n  }\n};"
      }
    },
    {
      "id": "a1b2c3d4-0001-4000-a000-000000000007",
      "name": "Check KSeF Match",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1520,
        360
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT ksef_number FROM invoices WHERE invoice_number = '{{ $json.invoice_number }}' AND firm_id = {{ $json.firm_id }} AND (seller_nip = '{{ $json.client_nip }}' OR buyer_nip = '{{ $json.client_nip }}') AND ksef_number IS NOT NULL LIMIT 1",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "Gun9basfq8zF7tYe",
          "name": "KSeF App DB"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "a1b2c3d4-0001-4000-a000-000000000030",
      "name": "Merge KSeF Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1650,
        360
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Merge KSeF lookup result with invoice data from Calculate Time Remaining\nconst calcData = $('Calculate Time Remaining').first().json;\nconst ksefResult = $json;\nconst ksefNumber = ksefResult.ksef_number || null;\n\nlet updatedUrgency = calcData.urgency;\nif (ksefNumber) updatedUrgency = 'found_in_ksef';\n\nreturn {\n  json: {\n    ...calcData,\n    urgency: updatedUrgency,\n    ksef_number: ksefNumber\n  }\n};"
      }
    },
    {
